{
  "schemaVersion": 1,
  "id": "flat2d",
  "version": "${version}",
  "name": "2D Items",
  "description": "Zeigt Items flach (2D) wie in aelteren Minecraft-Versionen. Einstellungen ueber das ModMenu.",
  "authors": ["Neoloni"],
  "license": "MIT",
  "icon": "assets/flat2d/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["io.neoloni.flat2d.Flat2DMod"],
    "modmenu": ["io.neoloni.flat2d.ModMenuIntegration"]
  },
  "mixins": ["flat2d.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "recommends": {
    "modmenu": "*"
  }
}
