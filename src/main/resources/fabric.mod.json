{
  "schemaVersion": 1,
  "id": "flat2d",
  "version": "${version}",
  "name": "2D Items",
  "description": "Zeigt Items auf dem Boden flach in 2D. Einstellungen ueber Mod Menu.",
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["io.flat2d.Flat2dClient"],
    "modmenu": ["io.flat2d.ModMenuIntegration"]
  },
  "mixins": ["flat2d.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "~1.21.11",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}
